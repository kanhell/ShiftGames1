  discreption: "\uB354\uBBF8\uB85C \uD558\uB098 \uB9CC\uB4E6"
  NPCData: {fileID: 11400000, guid: 5c4233e59da3ee648b8e6b8ecc97ccde, type: 2}
  background: {fileID: -8111623952810300270, guid: dd923a8ceebff074da043c9c849d36ec, type: 3}
  NPCState: 1
  DialogLines:
  - code: 00
    lines:
    - "\uC5B4\uC11C \uC640. \uC774 \uC2DC\uAC04\uC5D0 \uC5EC\uD589\uC790\uB294 \uB4DC\uBB38\uB370\u2026
      \uBB34\uC2A8 \uC77C\uC774\uC9C0?"
    options:
    - "\uC774 \uB9C8\uC744\uC5D0 \uB300\uD574 \uC880 \uBB3C\uC5B4\uBD10\uB3C4 \uB420\uAE4C\uC694?"
    - "\uD2B9\uBCC4\uD788 \uC218\uC0C1\uD55C \uC77C\uC740 \uC5C6\uC5C8\uB098\uC694?"
    nextCode_byOption:
    - 01
    - 02
  - code: 01
    lines:
    - "\uC774 \uB9C8\uC744 \uB9D0\uC774\uC9C0\u2026 \uAC89\uBCF4\uAE30\uC5D4 \uC870\uC6A9\uD574
      \uBCF4\uC5EC\uB3C4 \uADF8\uB807\uC9C0\uB9CC\uC740 \uC54A\uC544."
    - "\uBD81\uCABD \uC232\uC5D0\uB294 \uC544\uBB34\uB3C4 \uC798 \uAC00\uC9C0 \uC54A\uC9C0."
    - "\uC774\uC720\uB97C \uAD73\uC774 \uBB3B\uB294 \uC0AC\uB78C\uB3C4 \uC5C6\uACE0
      \uB9D0\uC774\uC57C."
    options:
    - "\uC65C \uC544\uBB34\uB3C4 \uC548 \uAC00\uC8E0?"
    - "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC870\uC2EC\uD560\uAC8C\uC694."
    nextCode_byOption:
    - 01-01
    - END
  - code: 02
    lines:
    - "\uADF8\uB7F0 \uC9C8\uBB38\uC740 \uBCF4\uD1B5 \uC5EC\uAE30\uC11C \uC548 \uD558\uC9C0."
    - "(\uC8FC\uBCC0\uC744 \uD790\uB057 \uC0B4\uD540\uB2E4)"
    - "\uD558\uC9C0\uB9CC\u2026 \uCD5C\uADFC \uC0AC\uB78C\uB4E4\uC774 \uD558\uB098\uB458
      \uC0AC\uB77C\uC9C0\uACE0 \uC788\uC5B4."
    options:
    - "\uC0AC\uB77C\uC84C\uB2E4\uACE0\uC694?"
    - "\uAD1C\uD55C \uC9C8\uBB38\uC744 \uD588\uAD70\uC694."
    nextCode_byOption:
    - 02-01
    - END
  - code: 01-01
    lines:
    - "\uBC24\uC774 \uB418\uBA74 \uC232\uC5D0\uC11C \uC774\uC0C1\uD55C \uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4\uACE0\uB4E4 \uD574."
    - "\uBBFF\uB4E0 \uB9D0\uB4E0 \uB124 \uC790\uC720\uC9C0\uB9CC \uB9D0\uC774\uC57C."
    - END
    options: []
    nextCode_byOption: []
  - code: 02-01
    lines:
    - "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBAA9\uACA9\uB41C \uACF3\uC740 \uB298 \uAC19\uC544."
    - "\uBD81\uCABD \uC232 \uADFC\uCC98\uC9C0."
    - END
    options: []
    nextCode_byOption: []
